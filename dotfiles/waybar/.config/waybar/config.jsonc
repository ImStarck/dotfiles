{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  
  // Choose which modules to display
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "custom/gpu", "pulseaudio", "custom/notifications", "custom/power"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },

  // Swedish clock with a dropdown calendar tooltip
  "clock": {
    "format": "{:%H:%M  -  %a, %d %b %Y}",
    "tooltip": false,
    "on-click": "gsimplecal"
  },

  // CPU usage tracker (Hovering shows individual core tooltips by default)
  "cpu": {
    "format": "cpu {usage}%",
    "tooltip": true
  },

  // RAM usage tracker
  "memory": {
    "format": "mem {percentage}%",
    "tooltip": true
  },

  // Custom GPU tracker. Checks AMD/Intel sysfs first, falls back to Nvidia-smi
  "custom/gpu": {
    "exec": "cat /sys/class/drm/card0/device/gpu_busy_percent 2>/dev/null || nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo 0",
    "format": "gpu {}%",
    "interval": 2,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "vol {volume}%"
  },

  // SwayNC notification bell
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": ""
    }
  },

  // Wlogout power button
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
  }
}